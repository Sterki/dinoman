APP_ENV=dev
APP_DEBUG=1
APP_SECRET=changeme-generate-a-32-char-random-string

# postgres es el nombre del servicio en Docker Compose
DATABASE_URL="postgresql://app:password@postgres:5432/diabetes_dev?serverVersion=16&charset=utf8"

# Origen permitido para llamadas al API desde el frontend
CORS_ALLOW_ORIGIN=http://localhost
